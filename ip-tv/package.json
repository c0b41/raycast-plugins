{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "iptv-turkey",
  "title": "IPTV Turkey",
  "description": "Browse Turkish IPTV channels and open them in VLC",
  "icon": "extension_icon.png",
  "author": "c0b41",
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search IPTV",
      "subtitle": "",
      "description": "Browse Turkish IPTV channels",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.3",
    "@raycast/utils": "^2.3.2",
    "iptv-playlist-parser": "^0.13.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "Windows"
  ]
}
